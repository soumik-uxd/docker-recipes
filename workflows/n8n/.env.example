POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=n8n
ANTHROPIC_API_KEY=your-anthropic-api-key

AZURE_OPENAI_API_KEY=your-azure-openai-api-key          # API_KEY for Azure OpenAI LLM
AZURE_OPENAI_API_ENDPOINT=your-azure-openai-endpoint    # Endpoint for Azure OpenAI LLM
AZURE_OPENAI_API_VERSION=2024-02-01                     # API Version for Azure OpenAI LLM
AZURE_OPENAI_API_DEPLOYMENT=gpt-4o                      # Deployment name for Azure OpenAI LLM
AZURE_OPENAI_EMBED_KEY=your-azure-embedding-api-key     # API_KEY for Azure OpenAI Embedding Model
AZURE_OPENAI_EMBED_ENDPOINT=your-azure-embedding-endpoint # Endpoint for Azure OpenAI Embedding Model
AZURE_OPENAI_EMBED_VERSION=2024-02-01
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small



N8N_ENCRYPTION_KEY=your-encryption-key
N8N_USER_MANAGEMENT_JWT_SECRET=your-jwt-secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

